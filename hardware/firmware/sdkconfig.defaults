CONFIG_ESP_CONSOLE_NONE=y
# loopTask 已无 Opus；实际以 platformio.ini -DARDUINO_LOOP_STACK_SIZE 与 getArduinoLoopTaskStackSize() 为准。
# 注意：纯 framework=arduino 时预编译 SDK 的 CONFIG_ARDUINO_LOOP_STACK_SIZE=8192 不会被本文件覆盖。
CONFIG_ARDUINO_LOOP_STACK_SIZE=24576

# /asr_chat 上语音 + JPEG 同连接，加大发送窗减轻大帧 write 超时
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=32768
CONFIG_LWIP_TCP_WND_DEFAULT=32768

# loop / 大栈任务可把栈放到 PSRAM（否则内部 SRAM 不够）
CONFIG_SPIRAM=y
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y

# ESP-SR: VADNet only (no WakeNet / MultiNet / NSNET)
CONFIG_MODEL_IN_FLASH=y
CONFIG_SR_VADN_VADNET1_MEDIUM=y
CONFIG_SR_NSN_WEBRTC=y
